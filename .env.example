# Copy to .env and adjust. Read by docker compose (variables below)
# and passed into the containers (FLASK_* settings).

# --- docker compose
ARCHIVE_PATH=/share/Multimedia/Astro
PORT=5080
# user/group that owns ./data on the host (ls -n data); must be able to read the archive
PUID=1000
PGID=1000
TZ=Europe/Berlin
# image version from ghcr.io/trickx/photonledger: latest (main), a release like 1.2.0, or sha-<commit>
PHOTONLEDGER_TAG=latest
# 1 = with Airgus (analyses ASIAIR/NINA night logs), 0 = without; only for a local
# "docker compose build" - the published image always contains Airgus
WITH_AIRGUS=1

# --- Photon Ledger settings (FLASK_<name>, values are JSON)
FLASK_SECRET_KEY=change-me
# seconds between two scans of the archive
FLASK_SCAN_INTERVAL=900
# focal lengths of one camera within 3 % count as the same
FLASK_FOCAL_TOLERANCE=0.03
# extra folder names to ignore (glob, case-insensitive)
FLASK_IGNORE_DIRS=["kollimation", "vergleich*"]
